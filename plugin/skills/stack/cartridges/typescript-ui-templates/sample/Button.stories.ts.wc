import type { Meta, StoryObj } from '@storybook/web-components'
import { html } from 'lit'
import { expect, userEvent, fn, within } from '@storybook/test'
import './Button'

// A story is a VIGNETTE of one state. Cover the reasonable states, not just the happy path.
const meta: Meta = {
  title: 'atoms/Button',
  render: ({ variant, loading, disabled, label, onClick }) =>
    html`<app-button
      variant=${variant}
      ?loading=${loading}
      ?disabled=${disabled}
      @app-click=${onClick}
      >${label}</app-button
    >`,
  args: { variant: 'primary', loading: false, disabled: false, label: 'Save', onClick: fn() },
}
export default meta
type Story = StoryObj

export const Primary: Story = {}
export const Secondary: Story = { args: { variant: 'secondary' } }
export const Danger: Story = { args: { variant: 'danger', label: 'Delete' } }
export const Disabled: Story = { args: { disabled: true } }
export const Loading: Story = { args: { loading: true } }
export const LongLabel: Story = { args: { label: 'A very long label that risks overflow' } }

// Interaction test lives IN the story (play). Story = vignette + test.
export const ClickFires: Story = {
  play: async ({ args, canvasElement }) => {
    const canvas = within(canvasElement)
    await userEvent.click(canvas.getByRole('button'))
    await expect(args.onClick).toHaveBeenCalledOnce()
  },
}

export const LoadingBlocksClick: Story = {
  args: { loading: true },
  play: async ({ args, canvasElement }) => {
    const canvas = within(canvasElement)
    await userEvent.click(canvas.getByRole('button'))
    await expect(args.onClick).not.toHaveBeenCalled()
  },
}
